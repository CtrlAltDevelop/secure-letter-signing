# Copy to brands/<brand>/.env (git-ignored). One file per company deployment.
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SERVER_PORT=8090
# Required in production (no fallback outside DJANGO_DEBUG=1). Each must be at least 32 characters, differ from the
# other, and not be a dev fallback, or the server refuses to start. Generate each with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Back both up with the database: losing or changing DATA_KEY makes stored letters unreadable, changing SEAL_SEED
# makes old seals fail verification. The same holds for the fixed HKDF salts in core/cryptoutil.py: never edit them
# on an existing deployment.
DJANGO_DATA_KEY=change-me-generate-with-the-command-above
DJANGO_SEAL_SEED=change-me-generate-another-one-with-the-command-above
# Without REDIS_URL, PIN and login rate limits are per-process (weaker with several workers); set it in production.
# Optional, in brands/<brand>/brand.json (not here): "modules": ["letters", "tasks", "projects"] lists the enabled
# modules (GET /api/me/modules); omit the key to enable every module. Disabled modules answer 404.
